# CLI authentication mode
# No runtime API-key injection.
# Use mounted host CLI session directories below.
DOCKER_CONTAINER_NAME=web-orchestrator-v1
CLI_AUTH_TIMEOUT_SECONDS=8
TLS_CA_CERT_FILE=/certs/eprism.pem

# Host session mount paths
# Windows example:
# HOST_GH_CONFIG_DIR=C:/Users/<you>/.config/gh
# HOST_CODEX_CONFIG_DIR=C:/Users/<you>/.codex
# HOST_GEMINI_CONFIG_DIR=C:/Users/<you>/.config/gemini
HOST_GH_CONFIG_DIR=./.auth/gh
HOST_CODEX_CONFIG_DIR=./.auth/codex
HOST_GEMINI_CONFIG_DIR=./.auth/gemini

# CLI command templates ({prompt} placeholder will be replaced safely)
GEMINI_CLI_CMD=gemini --prompt {prompt} --yolo
CODEX_CLI_CMD=codex exec --skip-git-repo-check --full-auto {prompt}

# Orchestrator runtime paths
WORKSPACE_DIR=/workspace
RAG_DIR=/workspace
RAG_MAX_SCAN_FILES=400
SPEC_PATH=/workspace/orchestrator/mvp/design_spec.example.json
MVP_OUTPUT_DIR=/app/data/mvp_runs
CLI_TIMEOUT_SEC=900

# Optional Notion integration
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
