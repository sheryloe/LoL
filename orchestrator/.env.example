# Runner / Orchestrator env example

# Optional: override runner target
RUNNER_BASE_URL=http://runner:8765

# Optional: enable write operations for git commit/push in runner
RUNNER_WRITE_ENABLED=false

# Optional: agent mode
# - mock: always built-in mock agent
# - auto: real CLI only when binary + API key are present, else mock
# - real: force real CLI defaults (codex/gemini) unless explicit command env overrides
RUNNER_AGENT_MODE=auto

# Optional: real CLI commands (leave empty to use mode defaults)
# Example:
# CODEX_CMD=codex exec --skip-git-repo-check --full-auto {prompt}
# GEMINI_CMD=gemini --prompt {prompt} --yolo
CODEX_CMD=
GEMINI_CMD=

# Optional: auth tokens for real CLIs
OPENAI_API_KEY=
GEMINI_API_KEY=
